# Copy to supabase/.env (never commit). Set same values as Edge Function secrets in Dashboard.

# --- Auto-injected on hosted Supabase (do not set manually unless local) ---
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Required secrets (Dashboard → Edge Functions → monitor-check → Secrets) ---

# Email that receives alerts. Without a verified Resend domain this MUST be
# the same email you used to sign up at resend.com (sandbox restriction).
ALERT_EMAIL=you@example.com

# API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxx

# Optional. Leave unset to use Resend sandbox sender onboarding@resend.dev
# After verifying a domain: RESEND_FROM=Flower Monitor <alerts@yourdomain.com>
# RESEND_FROM=

# Shared secret for cron/manual invoke (header: x-monitor-secret)
MONITOR_CRON_SECRET=generate-a-long-random-string

# Optional. Per-URL fetch timeout in ms (default 15000)
FETCH_TIMEOUT_MS=15000

# --- Local only (supabase start + functions serve) ---
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
