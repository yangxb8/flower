# Copy to supabase/.env (never commit). Used by deploy script for secrets + local serve.

# Hosted deploy — set before running scripts/deploy-supabase.ps1
# SUPABASE_PROJECT_REF=abcdefghijklmnop

# Edge Function secrets (pushed to hosted project)
ALERT_EMAIL=you@example.com
MONITOR_CRON_SECRET=generate-a-long-random-string
FETCH_TIMEOUT_MS=15000
RESEND_API_KEY=re_xxxx
RESEND_FROM=monitor@yourdomain.com

# Local only (supabase start + functions serve)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
