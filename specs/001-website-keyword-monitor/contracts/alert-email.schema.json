{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alert-email.schema.json",
  "title": "MonitorAlertEmail",
  "description": "Batch alert email payload when one or more URLs become newly eligible (在庫数 reappeared)",
  "type": "object",
  "required": ["subject", "recipient", "run_id", "matches"],
  "properties": {
    "subject": {
      "type": "string",
      "description": "e.g. [在庫数] 2 pages matched"
    },
    "recipient": {
      "type": "string",
      "format": "email"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "matches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["url", "h4_text"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "h4_text": {
            "type": "string",
            "description": "Text from div.flr h4 element(s), newline-separated if multiple"
          }
        }
      }
    }
  }
}
